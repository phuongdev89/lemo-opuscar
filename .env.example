AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_REFERENCE_SUPPORT=true
MUSEAI_IMAGE_ENDPOINT_URL=http://192.168.10.132:18610/v1
MUSEAI_IMAGE_API_KEY=m2a-xxxxxxxxxx
