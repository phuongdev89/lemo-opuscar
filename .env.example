# Lemo-Opuscar configuration
# Thư mục chứa các dự án phim đầu ra (mặc định là 'films')
# Có thể đổi thành: projects, outputs, videos, hoặc đường dẫn riêng
OUTPUT_DIR=films

AI_IMAGE_PROVIDER=museai# museai | zpro
AI_IMAGE_TYPE=edit
